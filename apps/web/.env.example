# Local dev: SQLite file (no setup needed)
DATABASE_URL="file:./dev.db"

# Vercel: a Postgres connection string (Neon free tier works)
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Better Auth: any random ≥32-char string; this also doubles as the
# liveness-token signing key in the demo (see lib/auth.ts).
BETTER_AUTH_SECRET="dev-secret-replace-me-with-at-least-32-chars"

# Public base URL — http://localhost:3000 locally; your Vercel URL in prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# Relying-party identifier. MUST match the hostname WebAuthn ceremonies
# expect — "localhost" locally, "your-app.vercel.app" in production.
RP_ID="localhost"
RP_NAME="expo-passkey-liveness demo"

# ─── Mobile companion (optional) ─────────────────────────────────────────────
# Set these when you want the apps/mobile Expo app to register passkeys
# against this backend. They enable two things:
#   1. native bundle origins are added to the WebAuthn trusted-origin list
#   2. /.well-known/apple-app-site-association and /.well-known/assetlinks.json
#      return populated bodies (so iOS / Android verify the binding)
#
# Bundle identifiers match apps/mobile/app.config.ts (com.iosazee.epkexample
# by default).
# MOBILE_IOS_BUNDLE_ID="com.iosazee.epkexample"
# MOBILE_IOS_TEAM_ID="ABCDE12345"
# MOBILE_ANDROID_PACKAGE="com.iosazee.epkexample"
# MOBILE_ANDROID_CERT_SHA256="AA:BB:CC:..."  # sha256 of your signing cert
